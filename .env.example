VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Variante acceptee (preffixe utilise sur Vercel pour eviter les collisions
# avec les variables partagees du compte) :
# E4U_VITE_SUPABASE_URL=...
# E4U_VITE_SUPABASE_ANON_KEY=...

# --- Rappel quotidien (notifications) ---
# Cle PUBLIQUE de signature des notifications. Publique par nature : elle
# voyage dans le code envoye au navigateur. La generer avec :
#   npx web-push generate-vapid-keys
# La cle PRIVEE de la meme paire ne se met JAMAIS ici : elle va dans les
# secrets Supabase (voir README.md, section « Rappel quotidien »).
# Sans cette variable, les rappels ne sont simplement pas proposes.
VITE_VAPID_PUBLIC_KEY=

# Aucune cle d'IA n'est necessaire : l'application n'appelle aucune API
# payante. La generation d'exercices par IA a ete retiree le 16/08/2026,
# a la demande de Loic. Ne pas definir ANTHROPIC_API_KEY sur Vercel.
